# =============================================================================
# VELOUR NestJS Backend — Environment Variables
# =============================================================================
# Copy this file to .env for local development.
# For cloud deployments, set these in the platform dashboard (Render, Railway etc.)
# NEVER commit .env with real secrets to Git.
# =============================================================================

# ─── RUNTIME ─────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=production   # Use "development" locally

# ─── DATABASE ─────────────────────────────────────────────────────────────────
# LOCAL (Docker Compose):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/velour_ecommerce?schema=public"

# NEON (Production — Pooled connection via pgBouncer, required for serverless):
# DATABASE_URL="postgresql://[user]:[password]@[host]-pooler.neon.tech/[dbname]?sslmode=require&pgbouncer=true&connect_timeout=30"
#
# NEON (Direct connection — use for prisma migrate deploy only):
# DATABASE_URL="postgresql://[user]:[password]@[host].neon.tech/[dbname]?sslmode=require"
#
# HOW TO GET: neon.tech → Project → Connection Details → toggle "Pooled connection"

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=velour_ecommerce

# ─── FRONTEND & CORS ──────────────────────────────────────────────────────────
# Supports comma-separated URLs for multiple origins:
# e.g. "https://velour.vercel.app,https://velour-staging.vercel.app"
FRONTEND_URL="http://localhost:3000"

# ─── JWT AUTHENTICATION ───────────────────────────────────────────────────────
# Generate a strong 64-char secret: openssl rand -hex 32
JWT_SECRET="velour_super_secure_jwt_secret_key_2026_fashion_lux_production_grade"
JWT_EXPIRATION="15m"

# ─── GOOGLE OAUTH ─────────────────────────────────────────────────────────────
# Get from: console.cloud.google.com → APIs & Services → Credentials
# Add Authorized JS Origins: https://[your-render-url].onrender.com
# Add Authorized Redirect URIs: https://[your-render-url].onrender.com/auth/google/callback
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET=""

# ─── RATE LIMITING ────────────────────────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ─── OTP SETTINGS ─────────────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ─── EMAIL / SMTP ─────────────────────────────────────────────────────────────
# Optional. Leave empty to disable transactional email.
# Free options: Gmail SMTP, Resend (3,000/mo free), Brevo (300/day free)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="VELOUR Atelier <no-reply@velour.com>"

# ─── WHATSAPP CLOUD API ───────────────────────────────────────────────────────
# Optional. Get from Meta Business Manager.
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=

# ─── MEDIA UPLOADS ────────────────────────────────────────────────────────────
# NOTE: Render free tier has no persistent disk. Uploaded files reset on redeploy.
# For production persistence, migrate to Cloudinary (free 1GB) or Backblaze B2 (free 10GB).
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR="./uploads"

# ─── SEEDING ─────────────────────────────────────────────────────────────────
# Set to "true" on first deploy (empty DB). Set to "false" after initial seed.
# The entrypoint already guards against re-seeding if users exist.
AUTO_SEED="true"
